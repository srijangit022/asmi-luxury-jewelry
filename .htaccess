# ==============================================================================
# ASMI LUXURY HAUTE JOAILLERIE - TRADITIONAL HOSTING CONFIGURATION (.htaccess)
# Compatible with: Apache 2.4+, LiteSpeed Web Server, cPanel Shared Hosting
# ==============================================================================

# 1. Primary Directory Index Document
# Ensures index.html is loaded as the storefront homepage
DirectoryIndex index.html index.php

# 2. LiteSpeed Connection Timeout & Execution Protection
# Prevents 408 Request Time-out on LiteSpeed and shared hosting servers
<IfModule Litespeed>
    RewriteEngine On
    RewriteRule .* - [E=noabort:1,E=noconntimeout:1]
</IfModule>

# 3. Apache Environment Directives
<IfModule mod_env.c>
    SetEnv noabort 1
    SetEnv noconntimeout 1
</IfModule>

# 4. MIME Types for Modern Web Performance
<IfModule mod_mime.c>
    AddType application/json json
    AddType image/webp webp
    AddType image/svg+xml svg svgz
    AddType font/woff2 woff2
    AddType font/woff woff
    AddType audio/mpeg mp3
    AddType video/mp4 mp4
</IfModule>

# 4b. Enable GZIP Compression for Fast Network Delivery
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
    AddOutputFilterByType DEFLATE application/javascript application/x-javascript application/json
    AddOutputFilterByType DEFLATE image/svg+xml application/xml
</IfModule>

# 5. Security & Directory Browsing Restrictions
Options -Indexes
ServerSignature Off

# 6. REST API URL Routing
# Directs /api/* requests to the standalone zero-dependency api.php router
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Route /api/ requests to api.php router
    RewriteRule ^api/(.*)$ api.php?endpoint=$1 [QSA,L]
    
    # Route /wp-json/asmi/v1/ requests to api.php for legacy compatibility
    RewriteRule ^wp-json/asmi/v1/(.*)$ api.php?endpoint=$1 [QSA,L]
</IfModule>

# 7. Browser Caching for Fast Page Loads
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/html "access plus 0 seconds"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
</IfModule>
